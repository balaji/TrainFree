// Copy this file to Secrets.xcconfig (gitignored) and fill in your iOS
// OAuth 2.0 Client ID from Google Cloud Console (must be in the same project
// as the Android OAuth client so both share Google Drive drive.file access).
//
// Example:
// GOOGLE_DRIVE_CLIENT_ID = 123456789012-abcdefg.apps.googleusercontent.com
// GOOGLE_DRIVE_REVERSED_CLIENT_ID = com.googleusercontent.apps.123456789012-abcdefg

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_REVERSED_CLIENT_ID=
